<%= form_with(model: post) do |form| %>
  <% if post.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(post.errors.count, "error") %> prohibited this post from being saved:</h2>

      <ul>
        <% post.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :titulo, style: "display: block" %>
    <%= form.text_area :titulo %>
  </div>

  <div>
    <%= form.label :conteudo, style: "display: block" %>
    <%= form.text_area :conteudo %>
  </div>
  <br>
  <div class="field">
    <%= form.label :imagem_capa, "Upload de Imagem" %>
    <%= form.file_field :imagem_capa, class: 'form-control' %>
  </div>
  <br>
  <div>
    <%= form.submit "Postar", class:"btn btn-success"%>
  </div>
<% end %>
