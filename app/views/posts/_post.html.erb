<div id="<%= dom_id post %>" class="col"> <%# Adicionei 'col' aqui se estiver usando row-cols no index %>
  
<br>
<div class="card bg-transparent mb-3 p-4 h-100">
    
    <div class="row g-0 align-items-center"> 

      <div class="col-md-4">
        <% if post.imagem_capa.attached? %>
          
          <%# Ajustando a imagem para ter uma altura fixa, ideal para prévias %>
          <%= image_tag post.imagem_capa.variant(resize_to_limit: [300, 600]), 
                        class: "img-fluid rounded-start", 
                        style: "height: 200px; object-fit: cover;", 
                        alt: "Imagem de capa do #{post.titulo}" %>
          
        <% else %>
          <div class="bg-secondary d-flex align-items-center justify-content-center rounded-start" 
               style="height: 200px; width: 100%;">
            <span class="text-white small">Sem imagem</span>
          </div>
        <% end %>
      </div>
      
      <div class="col-md-8">  
        <div class="card-body text-white p-2"> 

          <h4 class="card-title">
            <%= link_to post.titulo, post %>
          </h4>

          <p class="card-text small text-muted mb-2">
            <% 
              # 1. Pega o texto puro (Conteúdo é o nome do atributo)
              content_pura = post.conteudo
              
              # 2. Trunca o texto puro (aprox. 5 linhas)
              content_truncada = truncate(content_pura, 
                                          length: 150, 
                                          separator: ' ', 
                                          omission: '...')
            %>
            
            <%= simple_format(content_truncada).html_safe %>
          </p>

          <p class="card-text small mb-1">
            <i class="bi bi-calendar-event"></i> <%= post.created_at.strftime("%d/%m/%Y") %>
          </p>
          
          <p class="card-text small mb-1">
            <i class="bi bi-chat-dots"></i> <%= post.comments.count %> comentários
          </p>
          
        </div>
      </div>
    </div>
    
    <div class="mt-3 text-center">
      <%= link_to "Acessar posts e comentários", post, class: 'text-white btn btn-primary btn-sm' %> 
    </div>
    
  </div>
  <br> <br>
    <hr class="border-success my-2">
</div>

<br>