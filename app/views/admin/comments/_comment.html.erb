<div id="<%= dom_id comment %>" class="comment card bg-dark bg-transparent text-white my-3">
  <p>
    <%= comment.author %><br>
    <%= comment.email %><br>
    <%= link_to comment.url, comment.url if comment.url.present? %><br>
    <%= comment.body %><br>
    Postado: <%= time_ago_in_words(comment.created_at) %> atrás
  </p>

  <hr class="bg-success"/>

  <div class="d-flex justify-content-end gap-2">
    <%= link_to "Editar",
          edit_admin_post_comment_path(comment.post, comment),
          class: "btn btn-secondary btn-sm" %>

    <%= link_to "Apagar",
          admin_post_comment_path(comment.post, comment),
          method: :delete,
          data: { confirm: "Tem certeza?" },
          class: "btn btn-success btn-sm" %>
  </div>

</div>
