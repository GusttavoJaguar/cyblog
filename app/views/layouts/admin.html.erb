        <span class="navbar-toggler-icon"></span>
        
        </button>
        <div class="collapse navbar-collapse" id="navbarTogglerDemo01">
<ul class="navbar-nav me-auto mb-2 mb-lg-0" style="--bs-scroll-height: 100px;">
           
    <li class="nav-item">
      <a class="nav-link" href="<%= root_path %>">Início</a>
    </li>
    <li class="nav-item">
      <a class="nav-link" href="<%= sobre_path %>">Sobre</a>
    </li>
    
    <li class="nav-item">
      <a class="nav-link" href="<%= posts_path %>">Postagens</a>
    </li>
      <li class="nav-item">
