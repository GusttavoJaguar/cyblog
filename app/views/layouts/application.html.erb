<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "CybLog" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
     <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
    <script src="https://cdn.jsdelivr.net/npm/feather-icons/dist/feather.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>


    <%= javascript_importmap_tags %>


    <%= stylesheet_link_tag 'application', media: 'all', "data-turbo-track": "reload" %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
  
  </head>

  <body>


  <nav class="navbar fixed-top navbar-expand-lg navbar-dark py-3 text-white" style="border-bottom: 2px solid #149414;"> 
      <div class="container-fluid">
       
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarTogglerDemo01" aria-controls="navbarTogglerDemo01" aria-expanded="false" aria-label="Toggle navigation">          
        
        <span class="navbar-toggler-icon"></span>
        
        </button>
  <div class="collapse navbar-collapse" id="navbarTogglerDemo01">
    <ul class="navbar-nav me-auto mb-2 mb-lg-0" style="--bs-scroll-height: 100px;">
              
        <li class="nav-item">
          <a class="nav-link" href="<%= root_path %>">Início</a>
        </li>
        
        <li class="nav-item">
          <a class="nav-link" href="<%= sobre_path %>">Sobre</a>
        </li>
        
        <li class="nav-item">
          <a class="nav-link" href="<%= posts_path %>">Postagens</a>
        </li>

        <li class="nav-item">
          <a class="nav-link" href="<%= eventos_path %>">Eventos</a>
        </li>
      <!--    
        <li class="nav-item">
          <a class="nav-link" href="<%= inscricaos_path %>">Contato</a>
        </li>
    -->
    </ul>
    
  </div>
</nav>
<br><br>

<div class="container mt-2" align="center">
    
    <br><br>
  <%= yield %>

</div>
  

  <br><br><br>

  <div class="footer-container p-4">
        <div class="footer-about">
          <div class="footer-logo">
            <i data-feather="activity"></i>
            <span>CybLog</span>
          </div>
          <p>A plataforma da tecnologia: IA, análise de dados, blockchian e muito mais!</p>
          <div class="social-links">
            <a href="https://instagram.com/gusttavojaguar" target="_blank"><i data-feather="instagram"></i></a>
            <a href="https://www.tiktok.com/@gusttavojaguar?is_from_webapp=1&sender_device=pc" aria-label="TikTok" target="_blank"><i class="bi bi-tiktok"></i></a>
            <a href="https://www.youtube.com/@gusttavojaguar" target="_blank"><i data-feather="youtube"></i></a>
          </div>
        </div>
       
        <div class="footer-links">
          <h3>Contato</h3>
          <ul>
            <li><i data-feather="mail"></i> cyberjaguar@gmail.com</li>
            <li><i data-feather="phone"></i> (62) 9999-9999</li>
            <li><i data-feather="map-pin"></i> Goiânia, GO</li>
          </ul>
        </div>
      </div>
      <div class="copyright">
        &copy; 2026 CybLog - Todos os direitos reservados.
      </div>




      <script>
        feather.replace()
      </script>



  </body>
</html>
