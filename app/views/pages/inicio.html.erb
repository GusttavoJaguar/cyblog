<body>


<section id="events" class="mb-5">
    <h2 class="text-center mb-5 pb-2 border-bottom border-success d-inline-block">Eventos em Destaque</h2>
    
    <div class="row g-4">
        
        <% @eventos_recentes.each do |evento| %>
            <div class="col-md-4">
                <div class="card bg-dark text-white h-100 border border-secondary">
                    
                    <% if evento.imagem_evento.attached? %>
          
                        <%= image_tag evento.imagem_evento.variant(resize_to_limit: [300, 600]), 
                                        class: "img-fluid rounded-start", 
                                        style: "height: 200px; object-fit: cover;", 
                                        alt: "Imagem de capa do #{evento.nome}" %>
                        
                        <% else %>
                        <div class="bg-secondary d-flex align-items-center justify-content-center rounded-start" 
                            style="height: 200px; width: 100%;">
                            <span class="text-white small">Sem imagem</span>
                        </div>
                        <% end %>    

                    <div class="card-body">
                        <div class="d-flex justify-content-between mb-2 text-center">
                            <span class="badge bg-success d-flex align-items-center">
                                <p class="card-text small mb-1">
                                    <i class="bi bi-calendar-event"></i> 
                                    <%= evento.data.strftime("%d/%m/%Y %H:%M") %>
                                </p>
                            </span>
                            
                            <small class="text-muted"><%= evento.data.strftime("%d/%m/%Y") %></small>
                        </div>
                        
                        <h5 class="card-title"><%= evento.nome %></h5>
                        <p class="card-text small text-white mb-2">
            <% 
              content_pura = evento.descricao
              
              content_truncada = truncate(content_pura, 
                                          length: 50,  # <-- AQUI define o limite de caracteres (~5 linhas)
                                          separator: ' ', 
                                          omission: '...')
            %>
            
            <%= simple_format(content_truncada).html_safe %>
          </p>
                                        
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="text-success"><%= evento.local %></span>
                            
                            <a href="<%= evento_path(evento) %>" class="text-primary d-flex align-items-center">
                                <span>Detalhes</span>
                                <i data-feather="chevron-right" class="ms-1"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        <% end %>
        </div>
</section> 


<!-- Artists Spotlight -->
        <section class="mb-5">
            <h2 class="text-center mb-5 pb-2 border-bottom border-success d-inline-block">Tecnologias em Destaque</h2>
            
            <div class="row g-4">
                <!-- Artist 1 -->
                <div class="col-6 col-md-3 text-center">
                    <div class="mx-auto mb-3 rounded-circle overflow-hidden border border-success" style="width: 180px; height: 180px;">
                        <img src="<%= asset_path('mc1.jpg') %>" alt="tech" class="w-100 h-100 object-fit-cover">
                    </div>
                    
                    
                </div>
<!-- Artist 2 -->
                <div class="col-6 col-md-3 text-center">
                    <div class="mx-auto mb-3 rounded-circle overflow-hidden border border-success" style="width: 180px; height: 180px;">
                        <img src="<%= asset_path('mc2.jpg') %>" alt="tech" class="w-100 h-100 object-fit-cover">
                    </div>
                </div>
<!-- Artist 3 -->
                <div class="col-6 col-md-3 text-center">
                    <div class="mx-auto mb-3 rounded-circle overflow-hidden border border-success" style="width: 180px; height: 180px;">
                        <img src="<%= asset_path('mc3.jpg') %>" alt="tech" class="w-100 h-100 object-fit-cover">
                    </div>
                </div>
<!-- Artist 4 -->
                <div class="col-6 col-md-3 text-center">
                    <div class="mx-auto mb-3 rounded-circle overflow-hidden border border-success" style="width: 180px; height: 180px;">
                        <img src="<%= asset_path('mc4.jpg') %>" alt="tech" class="w-100 h-100 object-fit-cover">
                    </div>
                </div>
            </div>
        </section>
        <br><br><br>
    <section id="inscricaos" class="container py-5">
        <h2 class="text-center mb-5 pb-2 border-bottom border-success d-inline-block">Entre em contato</h2>
    </section>

     <!-- Newsletter -->
        <section class="bg-success bg-gradient mb-5 p-5 rounded-3">
            <div class="container">
                <div class="row justify-content-center">
                    <div class="col-md-8 text-center">
                        <h2 class="mb-3">Fique por dentro da CybLog!</h2>
                        <p class="mb-4">Cadastre-se para receber os melhores eventos de arte urbana diretamente no seu email.</p>
                        <form class="row g-3 justify-content-center">
                            <div class="col-md-8">
                                <input type="email" class="form-control form-control-lg" placeholder="Seu melhor email">
                            </div>
                            <div class="col-md-4">
                                <button type="submit" class="btn btn-success btn-lg w-100">
                                    Assinar
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </section>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
